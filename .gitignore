# Dependencias
node_modules/
.pnpm-store/
.yarn/
bun.lockb

# Carpetas y archivos ocultos del sistema
.*
!.gitignore
!.dockerignore
!.env.example
!.prettierrc
!.eslintrc.json
# Sin esto, la regla `.*` de arriba se tragaria .github y los workflows de
# CI nunca se podrian commitear. .github/copilot* sigue ignorado, porque esa
# regla aparece mas abajo y en gitignore gana la ultima coincidencia.
!.github/
# Igual que .github: sin esta negacion, `.*` impediria versionar los hooks.
# .husky/_ se vuelve a excluir al final del archivo (shims generados).
!.husky/

# Compilaciones y logs
dist/
build/
generated/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
bun-debug.log*

# Archivos de entorno
.env
.env.local
.env.*.local

# Credenciales Google (service account JSON) y dumps de sheets
sheets-credentials.json
sheets-export/

# Cache
.cache/
.parcel-cache/
.next/
.nuxt/
.output/
coverage/
playwright-report/
test-results/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db


# InsForge & AI agent skills
.insforge
.agent
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf

# Husky: los shims se generan con `bun install` (prepare), no se versionan.
# Los hooks reales en .husky/*.sh sí se versionan.
.husky/_
