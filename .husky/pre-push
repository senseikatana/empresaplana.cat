#!/usr/bin/env sh
# Solo formato. Nada mas.
#
# Aqui NO va release:check. El toolchain de releases vive FUERA del repo
# (~/.zsh/functions/git.zsh) y es el que crea los estados inconsistentes, asi
# que comprobar la version en cada push solo producia bloqueos falsos sobre
# codigo perfectamente correcto.
#
# La deriva de version sigue bloqueando donde importa de verdad:
#   bun run verify   (y por tanto deploy:insforge)
# Es decir: nunca llega a produccion con el manifest desfasado, pero si puedes
# subir codigo mientras tanto.
bun run check