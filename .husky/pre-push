#!/usr/bin/env sh
# NO se ejecutan tests aqui. La puerta completa corre explicitamente:
# bun run verify
#
# Este hook hace dos cosas baratas que evitan errores caros:
#   1. formato (Biome)          ~1s
#   2. que el manifest no quede atrasado  ~70ms
#
# El 2 existe por un incidente real: un release escribio v0.4.2 en
# package.json y, 48 segundos despues, un commit manual lo revirtio a 0.4.0.
# El guard de anti-downgrade del toolchain global no lo ve, porque solo observa
# los cambios que el propio toolchain hace. Esta comprobacion si las ve.
bun run check && bun run release:check