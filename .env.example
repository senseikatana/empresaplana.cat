# PostgreSQL database (InsForge) — credentials are NEVER committed
# Copy this file to .env and fill in real values.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.database.insforge.app:5432/insforge?sslmode=require
# Shared by Better Auth and the app's session JWT; generate a random secret.
AUTH_SECRET=
# Optional separate Better Auth secret; falls back to AUTH_SECRET when unset.
BETTER_AUTH_SECRET=
# Local: http://localhost:4321. Production: the canonical HTTPS site origin.
BETTER_AUTH_URL=http://localhost:4321
# Optional: connect this instance to the Better Auth Infrastructure dashboard.
BETTER_AUTH_API_KEY=
# OAuth callback URLs: {BETTER_AUTH_URL}/api/auth/callback/google
# and {BETTER_AUTH_URL}/api/auth/callback/github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Sheets sync (service account JSON path + spreadsheet id)
# The JSON key lives at the project root, gitignored (sheets-credentials.json).
GOOGLE_SERVICE_ACCOUNT_JSON=sheets-credentials.json
GOOGLE_SPREADSHEET_ID=

# Server-only InsForge Model Gateway key: npx -y @insforge/cli ai setup --env-file .env
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-5.5
