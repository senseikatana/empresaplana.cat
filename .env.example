
# PostgreSQL database (InsForge) — credentials are NEVER committed
# Copy this file to .env and fill in real values.
DATABASE_URL="postgresql://usuario:password"

# Native InsForge Auth; used only by the server.
# Get ANON_KEY through npx -y @insforge/cli secrets get ANON_KEY.
INSFORGE_URL=https://gcmw58vt.eu-central.insforge.app
INSFORGE_ANON_KEY=
# Optional canonical origin for OAuth returns. Leave blank for local development.
APP_URL=
# OAuth provider callback: {INSFORGE_URL}/api/auth/oauth/google/callback
# (or github/callback). App return: {APP_URL}/api/auth/exchange.
# Native auth emails use InsForge-managed delivery; configure in insforge.toml.

# Google Sheets sync (service account JSON path + spreadsheet id)
# The JSON key lives at the project root, gitignored (sheets-credentials.json).
# GOOGLE_SERVICE_ACCOUNT_JSON=sheets-credentials.json
# GOOGLE_SPREADSHEET_ID=

# INSFORGE AI: 
OPENROUTER_API_KEY=

# Sal para derivar el identificador de cliente de los reportes ciudadanos
# (src/lib/rate-limit.ts). OBLIGATORIA en producción: el código se niega a
# derivarla sin ella, porque con una constante pública el hash de (IP + user
# agent) sería reversible por fuerza bruta y por tanto dato personal
# recuperable. Generar con: openssl rand -hex 32
TRACKING_HASH_SECRET=

# RESEND (development only; never deployed. Production auth emails use InsForge):
AUTH_EMAIL_FROM="Empresa Plana <onboarding@resend.dev>"
RESEND_API_KEY=
RESEND_TEST_TO=
