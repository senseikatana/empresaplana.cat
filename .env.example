
# PostgreSQL database (InsForge) — credentials are NEVER committed
# Copy this file to .env and fill in real values.
DATABASE_URL="postgresql://usuario:password"

# Shared by Better Auth and the app's session JWT; generate a random secret.
# Local: http://localhost:PORT. Production: the canonical HTTPS site origin.
BETTER_AUTH_URL=http://localhost:PORT
# BETTER_AUTH_API_KEY=ba_kmfr2iiy7ytnrnp29unekeadno50i330
AUTH_SECRET=

# OAuth callback URLs: {BETTER_AUTH_URL}/api/auth/callback/google
# and {BETTER_AUTH_URL}/api/auth/callback/github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Sheets sync (service account JSON path + spreadsheet id)
# The JSON key lives at the project root, gitignored (sheets-credentials.json).
# GOOGLE_SERVICE_ACCOUNT_JSON=sheets-credentials.json
# GOOGLE_SPREADSHEET_ID=
# Application JWT secret; independent from BETTER_AUTH_API_KEY.

# INSFORGE CLI & DASHBOARD
INSFORGE_BASE_URL=https://path.insforge.app
INSFORGE_ANON_KEY=anon_
INSFORGE_API_KEY=ik_
JWT_KEY_ID=kid_

# INSFORGE AI: 
DEEPSEEK_API_KEY=sk-
OPENROUTER_API_KEY=sk-or-v1-

# RESEND API ONBOARDING:
AUTH_EMAIL_FROM="Business Name <onboarding@resend.dev>"
RESEND_API_KEY=re_
RESEND_TEST_TO=domain@domain.com
