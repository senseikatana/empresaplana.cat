{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "empresaplana-astro",
	"main": "./dist/server/entry.mjs",
	"compatibility_date": "2026-10-10",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "empresaplana.samuraicoder.dev",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"vars": {
		"BETTER_AUTH_URL": "https://empresaplana.samuraicoder.dev",
		"NODE_ENV": "production",
		"WEBAUTHN_RP_ID": "empresaplana.samuraicoder.dev"
	}
}
