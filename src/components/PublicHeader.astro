---
import { localizedPath } from "@/config/i18n/routing";
import { getDictionary } from "@/config/i18n";
import type { Locale } from "@/interfaces/common";
import type { UsuarioRole } from "@/interfaces/auth";
import { isCompanyRole } from "@/lib/acl";
import HeaderPreferences from "@/components/HeaderPreferences.astro";

interface Props {
	locale: Locale;
	role?: UsuarioRole | null;
	showAuthActions?: boolean;
}

const { locale, role = null, showAuthActions = true } = Astro.props;
const dict = getDictionary(locale);
const { common } = dict;
const localeHref = (path: string) => localizedPath(path, locale);
const contactHref = localizedPath("/#contacto", locale);
const accountHref = role
	? isCompanyRole(role)
		? "/dashboard"
		: "/perfil"
	: undefined;
const accountLabel = role
	? isCompanyRole(role)
		? common.nav.companyDashboard
		: common.nav.profile
	: undefined;
---

<header class="relative z-20 bg-surface-container-lowest">
	<div class="border-b border-outline-variant/40 bg-deep-navy text-white">
		<div class="mx-auto flex h-11 max-w-container-max items-center justify-between gap-3 px-margin-mobile text-sm md:justify-end md:gap-6 md:px-margin-desktop">
			<a
				class="inline-flex items-center gap-2 transition-colors hover:text-secondary-fixed"
				href="tel:+34977553680"
			>
				<span aria-hidden="true" class="material-symbols-outlined text-lg">call</span>
				+34 977 553 680
			</a>
			<span aria-hidden="true" class="h-4 w-px bg-on-primary/30"></span>
			<HeaderPreferences locale={locale} />
		</div>
	</div>
	<div class="mx-auto flex max-w-container-max items-center justify-between gap-3 px-margin-mobile py-4 md:px-margin-desktop">
		<a
			class="shrink-0 text-lg font-bold tracking-tight text-deep-navy sm:text-xl md:text-2xl"
			href={localeHref("/")}
			aria-label={common.brand}
		>
			{common.brand}
		</a>
		<nav
			class="hidden items-center gap-6 text-sm font-semibold text-on-surface-variant xl:flex"
			aria-label={common.brand}
		>
			<a class="transition-colors hover:text-deep-navy" href={localeHref("/servicios-discrecionales")}>
				{common.nav.services}
			</a>
			<a class="transition-colors hover:text-deep-navy" href={localeHref("/donde-estamos")}>
				{common.nav.locations}
			</a>
			<a class="transition-colors hover:text-deep-navy" href={localeHref("/rutas-horarios")}>
				{common.nav.downloads}
			</a>
			<a class="transition-colors hover:text-deep-navy" href={contactHref}>
				{common.nav.contact}
			</a>
		</nav>
		<div class="flex shrink-0 items-center gap-2 sm:gap-3">
			{showAuthActions && !role && (
				<>
					<a
						class="inline-flex min-h-11 min-w-11 items-center justify-center whitespace-nowrap rounded-full border border-outline-variant px-2 text-xs font-semibold text-deep-navy transition-colors hover:border-deep-navy hover:bg-surface-container-low focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy sm:min-w-0 sm:px-4 sm:text-sm"
						href={localeHref("/dashboard/login")}
					>
									<span aria-hidden="true" class="material-symbols-outlined text-lg sm:hidden">login</span>
									<span class="sr-only sm:not-sr-only">{common.nav.login}</span>
								</a>
								<a
									class="inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-full bg-energetic-orange px-2 text-xs font-bold text-on-background transition-colors hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy sm:px-4 sm:text-sm"
									href={localeHref("/dashboard/register")}
								>
						{common.nav.register}
					</a>
				</>
			)}
			{showAuthActions && role && accountHref && accountLabel && (
				<a
					class="inline-flex min-h-11 items-center justify-center gap-1 whitespace-nowrap rounded-full bg-deep-navy px-2 text-xs font-semibold text-white transition-colors hover:bg-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy sm:gap-2 sm:px-4 sm:text-sm"
					href={localeHref(accountHref)}
				>
					<span aria-hidden="true" class="material-symbols-outlined text-lg">account_circle</span>
					{accountLabel}
				</a>
			)}
		</div>
	</div>
	<nav
		class="overflow-x-auto border-t border-outline-variant/30 px-margin-mobile xl:hidden"
		aria-label={common.brand}
	>
		<div class="mx-auto flex max-w-container-max items-center gap-6 py-3 text-sm font-semibold text-on-surface-variant">
			<a class="shrink-0 hover:text-deep-navy" href={localeHref("/servicios-discrecionales")}>
				{common.nav.services}
			</a>
			<a class="shrink-0 hover:text-deep-navy" href={localeHref("/donde-estamos")}>
				{common.nav.locations}
			</a>
			<a class="shrink-0 hover:text-deep-navy" href={localeHref("/rutas-horarios")}>
				{common.nav.downloads}
			</a>
			<a class="shrink-0 hover:text-deep-navy" href={contactHref}>
				{common.nav.contact}
			</a>
		</div>
	</nav>
</header>
