---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicHeader from "@/components/PublicHeader.astro";
import { getDictionary } from "@/config/i18n";
import type { Locale } from "@/interfaces/common";

interface Props {
	title: string;
	locale: Locale;
}

const { title, locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout
	title={`${title} | ${dict.common.brand}`}
	lang={locale}
	description={dict.meta.description}
	bodyClass="bg-background text-on-background font-body-md antialiased min-h-screen flex flex-col"
>
	<PublicHeader locale={locale} showAuthActions={false} />
	<main class="flex flex-1 items-center bg-surface-container-low px-margin-mobile py-8 md:px-margin-desktop md:py-12">
		<section class="mx-auto grid w-full max-w-5xl overflow-hidden rounded-2xl border border-outline-variant/60 bg-surface-container-lowest shadow-[0_18px_50px_rgba(1,37,99,0.12)] md:grid-cols-[1fr_0.9fr]">
			<div class="flex items-center p-6 sm:p-10 lg:p-14">
				<div class="mx-auto w-full max-w-md">
					<a
						class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-deep-navy hover:text-secondary"
						href={`/?lang=${locale}`}
					>
						<span aria-hidden="true" class="material-symbols-outlined text-lg">arrow_back</span>
						{dict.common.brand}
					</a>
					<slot />
				</div>
			</div>
			<aside class="relative min-h-64 overflow-hidden bg-deep-navy md:min-h-full">
				<img
					class="absolute inset-0 h-full w-full object-cover"
					src="/images/empresa-plana-fleet.jpg"
					alt=""
					width="1294"
					height="1009"
					loading="lazy"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-deep-navy/95 via-deep-navy/45 to-deep-navy/5"></div>
				<div class="absolute inset-x-0 bottom-0 p-7 text-white sm:p-10">
					<span aria-hidden="true" class="material-symbols-outlined text-4xl text-secondary-fixed">directions_bus</span>
					<h2 class="mt-5 max-w-sm text-2xl font-bold leading-tight tracking-tight sm:text-3xl">
						{dict.app.auth.imageTitle}
					</h2>
					<p class="mt-3 max-w-sm text-sm leading-6 text-white/85">
						{dict.app.auth.imageDescription}
					</p>
				</div>
			</aside>
		</section>
	</main>
</BaseLayout>
