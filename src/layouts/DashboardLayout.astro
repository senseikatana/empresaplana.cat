---
/**
 * DashboardLayout.astro
 *
 * Main dashboard shell for authenticated pages. Provides:
 * - Responsive sidebar (collapses to hamburger on mobile)
 * - Top navbar with language switcher + dark mode toggle
 * - Nav items filtered by user role
 * - User info + logout in sidebar footer
 *
 * Does NOT use BaseLayout - builds its own <html> structure.
 * User data is passed as a prop from the page (fetched server-side).
 */
import "@/styles/global.css";
import { canAccessDashboardPath, isRole, type Role } from "@/lib/acl";
import { getDictionary, getLocale } from "@/config/i18n";
import HeaderPreferences from "@/components/HeaderPreferences.astro";
import ThemeInit from "@/components/ThemeInit.astro";
import { localizedPath, unlocalizedPath } from "@/config/i18n/routing";
import type { PublicUser } from "@/interfaces/users";

interface Props {
	title: string;
	locale: string;
	user: PublicUser | null;
}

const { title, locale: rawLocale, user } = Astro.props;
const currentLocale = getLocale(rawLocale);
const dict = getDictionary(currentLocale);

// Resolve role for nav filtering
const role: Role | undefined = user && isRole(user.role) ? user.role : undefined;

const displayName = user?.name || user?.fullName || user?.username || "";
const roleLabel = role ? dict.app.role[role] : "";
const sectionNav = dict.app.gestion.nav;
const companyNav = [
	{ label: dict.ai.title, icon: "auto_awesome", href: "/dashboard/ia" },
	{ label: sectionNav.panel, icon: "dashboard", href: "/dashboard/gestion" },
	{ label: sectionNav.map, icon: "map", href: "/dashboard/gestion/mapa" },
	{ label: sectionNav.routes, icon: "route", href: "/dashboard/gestion/rutas" },
	{ label: sectionNav.buses, icon: "directions_bus", href: "/dashboard/gestion/autobuses" },
	{ label: sectionNav.stops, icon: "place", href: "/dashboard/gestion/paradas" },
	{ label: sectionNav.schedules, icon: "schedule", href: "/dashboard/gestion/horarios" },
	{ label: sectionNav.drivers, icon: "badge", href: "/dashboard/gestion/conductores" },
	{ label: sectionNav.notifications, icon: "notifications", href: "/dashboard/gestion/notificaciones" },
	{ label: sectionNav.reports, icon: "bar_chart", href: "/dashboard/gestion/reportes" },
	{ label: dict.management.entities.documentos, icon: "description", href: "/dashboard/gestion/documentos" },
	{ label: dict.management.entities.incidencias, icon: "report_problem", href: "/dashboard/gestion/incidencias" },
	{ label: dict.management.entities.mantenimiento, icon: "build", href: "/dashboard/gestion/mantenimiento" },
	{ label: dict.management.entities.oficinas, icon: "apartment", href: "/dashboard/gestion/oficinas" },
	{ label: dict.management.entities.presupuestos, icon: "request_quote", href: "/dashboard/gestion/presupuestos" },
	{ label: dict.management.entities.lineas, icon: "alt_route", href: "/dashboard/gestion/lineas" },
	{ label: dict.management.entities["horarios-linea"], icon: "event", href: "/dashboard/gestion/horarios-linea" },
	{ label: dict.management.entities.conexiones, icon: "connecting_airports", href: "/dashboard/gestion/conexiones" },
	{ label: sectionNav.integrations, icon: "power", href: "/dashboard/gestion/integraciones" },
	{ label: sectionNav.users, icon: "group", href: "/dashboard/gestion/usuarios" },
	{ label: dict.app.panel.messages, icon: "chat", href: "/dashboard/mensajes" },
];

/**
 * Sección propia de cada rol. Antes no existía: cliente y empleado aterrizaban
 * en su dashboard sin ningún enlace lateral, y el menú de compañía se les
 * mostraba entero (con `hasCapability(role, "dashboard:access")`, que los cuatro
 * roles tienen) apuntando a rutas que el middleware les negaba.
 *
 * Reutiliza etiquetas que ya existen en `app.panel` y `app.gestion.nav`, así
 * que no hace falta tocar los cuatro ficheros de i18n.
 */
const roleSectionNav: Partial<Record<Role, typeof companyNav>> = {
	client: [
		{ label: sectionNav.panel, icon: "dashboard", href: "/dashboard/cliente" },
		{ label: dict.app.panel.favorites, icon: "favorite", href: "/dashboard/cliente/favoritas" },
		{ label: dict.app.panel.quotes, icon: "request_quote", href: "/dashboard/cliente/cotizaciones" },
		{ label: dict.app.panel.account, icon: "person", href: "/dashboard/cliente/cuenta" },
	],
	worker: [
		{ label: sectionNav.panel, icon: "dashboard", href: "/dashboard/trabajador" },
		{ label: dict.app.panel.lines, icon: "route", href: "/dashboard/trabajador/lineas" },
		{ label: dict.app.panel.incidents, icon: "report_problem", href: "/dashboard/trabajador/incidencias" },
		{ label: dict.app.panel.reports, icon: "bar_chart", href: "/dashboard/trabajador/reportes" },
	],
};

// El menú se filtra con el mismo predicado que aplica el middleware: una sola
// fuente de verdad, y nunca una entrada que vaya a ser rechazada al pulsarla.
const navItems = role
	? [...(roleSectionNav[role] ?? []), ...companyNav].filter((item) =>
			canAccessDashboardPath(role, item.href),
		)
	: [];

const footerNav = [
	{ label: dict.app.panel.account, icon: "person", href: "/perfil" },
	{ label: dict.app.panel.backToSite, icon: "open_in_new", href: "/" },
];

// Current path for active state
const currentPath = unlocalizedPath(Astro.url.pathname);

function isActive(href: string): boolean {
	return currentPath === href || currentPath.startsWith(href + "/");
}
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeInit />
    <title>{title} | Empresa Plana</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      .nav-item-active {
        background-color: rgba(19, 174, 184, 0.12);
        color: var(--brand-secondary);
      }
      .nav-item-active .material-symbols-outlined {
        color: var(--brand-secondary);
      }
      #app-sidebar {
        transition: transform 0.3s ease;
      }
    </style>
  </head>
  <body class="bg-surface text-on-surface font-sans min-h-screen">
    <!-- Mobile overlay -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"
      onclick="toggleSidebar()"
    ></div>

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside
        id="app-sidebar"
        class="fixed lg:sticky top-0 left-0 z-50 h-screen w-64 bg-surface-container-low border-r border-outline-variant flex flex-col -translate-x-full lg:translate-x-0 shrink-0"
      >
        <!-- Brand -->
        <div class="flex items-center gap-2.5 px-4 h-16 border-b border-outline-variant shrink-0">
          <span class="material-symbols-outlined text-xl text-deep-navy">
            directions_bus
          </span>
          <span class="font-bold text-on-surface truncate">
            Empresa Plana
          </span>
        </div>

        <!-- Main nav -->
        <nav class="flex-1 overflow-y-auto py-2 px-2">
          {
            navItems.map((item) => (
              <a
                href={localizedPath(item.href, currentLocale)}
                class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors mb-0.5 ${
                  isActive(item.href)
                    ? "nav-item-active"
                    : "text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface"
                }`}
              >
                <span class="material-symbols-outlined text-[20px]">
                  {item.icon}
                </span>
                <span class="truncate">{item.label}</span>
              </a>
            ))
          }
        </nav>

        <!-- Footer: back to site + user info -->
        <div class="border-t border-outline-variant p-2 shrink-0">
          {
            footerNav.map((item) => (
              <a
                href={localizedPath(item.href, currentLocale)}
                class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors mb-0.5"
              >
                <span class="material-symbols-outlined text-[20px]">
                  {item.icon}
                </span>
                <span class="truncate">{item.label}</span>
              </a>
            ))
          }
          <div class="flex items-center gap-2 px-2 py-2">
            <div
              class="w-8 h-8 rounded-full bg-deep-navy text-white flex items-center justify-center text-sm font-semibold shrink-0"
            >
              {displayName.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-on-surface truncate">
                {displayName}
              </p>
              <p class="text-xs text-on-surface-variant">{roleLabel}</p>
            </div>
            <button
              id="logout-btn"
              class="p-1.5 rounded-md hover:bg-surface-container-high text-on-surface-variant transition-colors"
              title={dict.app.nav.logout}
            >
              <span class="material-symbols-outlined text-[18px]">
                logout
              </span>
            </button>
          </div>
        </div>
      </aside>

      <!-- Main content -->
      <main class="flex-1 min-w-0">
        <!-- Top navbar -->
        <header
          class="sticky top-0 z-30 h-14 bg-surface-container-lowest/80 backdrop-blur-md border-b border-outline-variant flex items-center px-4 gap-3"
        >
          <!-- Hamburger (mobile) -->
          <button
            id="hamburger-btn"
            class="lg:hidden p-1.5 rounded-md hover:bg-surface-container-high text-on-surface-variant"
            onclick="toggleSidebar()"
          >
            <span class="material-symbols-outlined">menu</span>
          </button>

          <div class="flex-1"></div>

          <HeaderPreferences locale={currentLocale} />
        </header>

        <!-- Page content -->
        <div class="p-4 lg:p-6">
          <slot />
        </div>
      </main>
    </div>

    <!-- Client-side scripts -->
    <script define:vars={{ logoutPath: localizedPath("/dashboard/login", currentLocale) }}>
      // Sidebar toggle
      function toggleSidebar() {
        const sidebar = document.getElementById("app-sidebar");
        const overlay = document.getElementById("sidebar-overlay");
        if (!sidebar || !overlay) return;
        const isOpen = !sidebar.classList.contains("-translate-x-full");

        if (isOpen) {
          sidebar.classList.add("-translate-x-full");
          overlay.classList.add("hidden");
        } else {
          sidebar.classList.remove("-translate-x-full");
          overlay.classList.remove("hidden");
        }
      }

      // Logout
      document
        .getElementById("logout-btn")
        ?.addEventListener("click", async () => {
          try {
            await fetch("/api/auth/logout", { method: "POST" });
          } catch {
            // ignore
          }
          window.location.href = logoutPath;
        });
    </script>
  </body>
</html>
