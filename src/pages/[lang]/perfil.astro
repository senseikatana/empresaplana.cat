---
import { localizedPath } from "@/config/i18n/routing";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocale, getDictionary } from "@/config/i18n";
import { getSession } from "@/lib/auth";
import { getPublicUser } from "@/lib/get-public-user";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) return Astro.redirect(localizedPath("/dashboard/login", getLocale(Astro.params.lang)));

const locale = getLocale(Astro.params.lang);
const dict = getDictionary(locale);
const user = await getPublicUser(session.id);
if (!user) return Astro.redirect(localizedPath("/dashboard/login", getLocale(Astro.params.lang)));

const roleLabel = dict.app.role[session.role];
const createdAt = user.createdAt
	? new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(user.createdAt)
	: null;
---

<BaseLayout
	title={`${dict.app.panel.account} | ${dict.common.brand}`}
	lang={locale}
	description={dict.app.panel.accountSubtitle}
	bodyClass="min-h-screen bg-background font-body-md text-on-background antialiased"
>
	<main class="mx-auto w-full max-w-container-max px-margin-mobile py-10 md:px-margin-desktop md:py-16">
		<div class="mx-auto max-w-3xl">
			<div class="flex flex-wrap items-start justify-between gap-4">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.12em] text-coastal-teal">
						{dict.app.panel.account}
					</p>
					<h1 class="mt-2 text-3xl font-bold tracking-tight text-deep-navy md:text-4xl">
						{dict.app.panel.accountTitle}
					</h1>
					<p class="mt-3 max-w-2xl text-base leading-7 text-on-surface-variant">
						{dict.app.panel.profileIntro}
					</p>
				</div>
				<span class="inline-flex rounded-full bg-primary-fixed px-4 py-2 text-sm font-semibold text-deep-navy">
					{roleLabel}
				</span>
			</div>

			<section class="mt-8 rounded-2xl border border-outline-variant/70 bg-surface-container-lowest p-5 shadow-ambient sm:p-8">
				<div class="mb-7 flex flex-wrap items-start justify-between gap-4 border-b border-outline-variant/50 pb-5">
					<div>
						<h2 class="text-xl font-bold text-deep-navy">{dict.app.panel.accountTitle}</h2>
						<p class="mt-1 text-sm text-on-surface-variant">{dict.app.panel.accountSubtitle}</p>
					</div>
					{createdAt && (
						<p class="text-sm text-on-surface-variant">
							<span class="font-semibold text-on-surface">{dict.app.panel.memberSince}:</span> {createdAt}
						</p>
					)}
				</div>

				<form id="profile-form" class="grid gap-5 sm:grid-cols-2">
					<div>
						<label for="username" class="mb-2 block text-sm font-semibold text-on-surface">
							{dict.app.auth.username}
						</label>
						<input
							id="username"
							value={user.username}
							readonly
							class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface-container-low px-4 text-base text-on-surface-variant"
						/>
					</div>
					<div>
						<label for="fullName" class="mb-2 block text-sm font-semibold text-on-surface">
							{dict.app.panel.name}
						</label>
						<input
							id="fullName"
							name="fullName"
							value={user.fullName || user.name}
							maxlength="120"
							required
							data-initial={user.fullName || user.name}
							class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
						/>
					</div>
					<div>
						<label for="phone" class="mb-2 block text-sm font-semibold text-on-surface">
							{dict.app.panel.phone}
						</label>
						<input
							id="phone"
							name="phone"
							type="tel"
							autocomplete="tel"
							value={user.phone ?? ""}
							data-initial={user.phone ?? ""}
							class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
						/>
					</div>
					<div>
						<label for="email" class="mb-2 block text-sm font-semibold text-on-surface">
							{dict.app.panel.email}
						</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							value={user.email}
							data-initial={user.email}
							required
							class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
						/>
					</div>

					<div class="sm:col-span-2">
						<p class="text-sm font-semibold text-on-surface">{dict.app.panel.passwordHint}</p>
					</div>
					<div>
						<label for="newPassword" class="mb-2 block text-sm font-semibold text-on-surface">
							{dict.app.panel.newPassword}
						</label>
						<input
							id="newPassword"
							name="newPassword"
							type="password"
							autocomplete="new-password"
							minlength="12"
							maxlength="128"
							class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
						/>
					</div>
					<div>
						<label for="currentPasskey" class="mb-2 block text-sm font-semibold text-on-surface">
							{dict.app.panel.currentPassword}
						</label>
						<input
							id="currentPasskey"
							name="currentPasskey"
							type="password"
							autocomplete="current-password"
							class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
						/>
					</div>

					<div class="flex flex-wrap items-center gap-4 sm:col-span-2">
						<button
							type="submit"
							class="inline-flex min-h-12 items-center justify-center rounded-full bg-energetic-orange px-6 font-bold text-on-background transition-colors hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy disabled:cursor-wait disabled:opacity-60"
						>
							{dict.app.panel.save}
						</button>
						<p
							id="profile-status"
							class="hidden text-sm font-medium"
							role="status"
							aria-live="polite"
						></p>
					</div>
				</form>

				<form id="logout-form" class="mt-8 border-t border-outline-variant/50 pt-5">
					<button type="submit" class="text-sm font-semibold text-on-surface-variant underline underline-offset-4 hover:text-deep-navy">
						{dict.app.nav.logout}
					</button>
				</form>
			</section>
		</div>
	</main>

	<script define:vars={{ loginPath: localizedPath("/dashboard/login", locale), savedMessage: dict.app.panel.saved, errorMessage: dict.app.panel.saveError, connectionMessage: dict.app.auth.connectionError }}>
		const profileForm = document.getElementById("profile-form");
		const status = document.getElementById("profile-status");
		const logoutForm = document.getElementById("logout-form");

		profileForm?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!(profileForm instanceof HTMLFormElement)) return;
			const button = profileForm.querySelector('button[type="submit"]');
			if (!(button instanceof HTMLButtonElement)) return;
			status?.classList.add("hidden");

			const fields = new FormData(profileForm);
			const payload = {};
			for (const key of ["fullName", "phone", "email"]) {
				const input = profileForm.elements.namedItem(key);
				if (input instanceof HTMLInputElement && input.value.trim() !== input.dataset.initial) {
					payload[key] = input.value.trim();
				}
			}
			const newPassword = String(fields.get("newPassword") ?? "");
			const currentPasskey = String(fields.get("currentPasskey") ?? "");
			if (newPassword) payload.newPassword = newPassword;
			if ((payload.email || newPassword) && currentPasskey) payload.currentPasskey = currentPasskey;

			if (Object.keys(payload).length === 0) {
				if (status) {
					status.textContent = savedMessage;
					status.className = "text-sm font-medium text-coastal-teal";
				}
				return;
			}

			button.disabled = true;
			button.setAttribute("aria-busy", "true");
			try {
				const response = await fetch("/api/account", {
					method: "PATCH",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				});
				if (!response.ok) {
					if (status) {
						status.textContent = errorMessage;
						status.className = "text-sm font-medium text-error";
					}
					return;
				}
				const inputs = ["fullName", "phone", "email"];
				for (const name of inputs) {
					const input = profileForm.elements.namedItem(name);
					if (input instanceof HTMLInputElement) input.dataset.initial = input.value.trim();
				}
				profileForm.reset();
				for (const name of inputs) {
					const input = profileForm.elements.namedItem(name);
					if (input instanceof HTMLInputElement) input.value = input.dataset.initial ?? "";
				}
				if (status) {
					status.textContent = savedMessage;
					status.className = "text-sm font-medium text-coastal-teal";
				}
			} catch {
				if (status) {
					status.textContent = connectionMessage;
					status.className = "text-sm font-medium text-error";
				}
			} finally {
				button.disabled = false;
				button.removeAttribute("aria-busy");
			}
		});

		logoutForm?.addEventListener("submit", async (event) => {
			event.preventDefault();
			try {
				const response = await fetch("/api/auth/logout", { method: "POST" });
				if (!response.ok) throw new Error("Logout failed");
				window.location.assign(loginPath);
			} catch {
				if (status) {
					status.textContent = connectionMessage;
					status.className = "text-sm font-medium text-error";
				}
			}
		});
	</script>
</BaseLayout>
