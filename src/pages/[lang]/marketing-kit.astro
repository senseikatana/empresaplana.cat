---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Empresa Plana - Marketing">
	<main class="mx-auto w-full max-w-container px-margin-mobile py-stack-lg md:px-margin-desktop">
		<section class="mx-auto max-w-2xl rounded-xl bg-surface-container-lowest p-stack-lg text-center shadow-ambient">
			<p class="mb-stack-sm text-label-md font-semibold uppercase text-coastal-teal">Empresa Plana</p>
			<h1 class="mb-stack-sm text-display-lg font-bold text-deep-navy">Explora la Costa Dorada con Empresa Plana</h1>
			<p class="text-body-lg text-on-surface-variant">Viaja con comodidad y confianza por Tarragona, Reus, Salou y los principales destinos del Mediterráneo.</p>
		</section>
	</main>
</BaseLayout>
