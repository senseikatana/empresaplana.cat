---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteInfo, getCanonicalUrl } from "@/config/site-info";
import { getLocale, getDictionary } from "@/config/i18n";

export const prerender = false;

const locale = getLocale(Astro.params.lang);
const dict = getDictionary(locale);
const siteInfo = getSiteInfo({
	title: dict.mobileApp.title,
	description: dict.home.screens.mobile.desc,
	lang: locale,
	ogTitle: dict.mobileApp.hero.title,
	ogDescription: dict.home.screens.mobile.desc,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
});
const bodyClass =
	"bg-background text-on-background font-body-md antialiased overflow-x-hidden min-h-screen flex flex-col";
---

<BaseLayout {...siteInfo} bodyClass={bodyClass}>
<!-- Main Content Canvas -->
<main class="mx-auto w-full max-w-[480px] flex-grow pb-24">
<!-- Hero Section with Search -->
<section class="px-margin-mobile pt-stack-md pb-stack-lg relative">
<!-- Decorative background element -->
<div class="absolute inset-0 bg-gradient-to-b from-surface-container-lowest to-surface-container -z-10 h-3/4 rounded-b-3xl"></div>
<h1 class="font-headline-lg-mobile text-headline-lg-mobile text-deep-navy mb-stack-md px-2 text-center">Where are you going?</h1>
<!-- Booking Card -->
<div class="bg-surface-container-lowest rounded-xl p-stack-md shadow-[0px_4px_20px_rgba(1,57,144,0.08)] border border-surface-variant relative overflow-hidden">
<!-- Search Inputs -->
<div class="flex flex-col gap-stack-sm relative z-10">
<!-- Origin Input -->
<div class="relative">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-coastal-teal">
<span class="material-symbols-outlined" data-icon="location_on" data-weight="fill" style="font-variation-settings: 'FILL' 1;">location_on</span>
</div>
<input class="w-full pl-10 pr-4 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder="From (e.g. Barcelona Airport)" type="text"/>
</div>
<!-- Swap Button -->
<div class="absolute right-4 top-[42px] z-20 flex justify-center items-center h-0 w-0">
<button class="bg-surface-container-lowest border border-surface-variant rounded-full p-2 shadow-sm text-deep-navy hover:text-coastal-teal transition-colors">
<span class="material-symbols-outlined" data-icon="swap_vert">swap_vert</span>
</button>
</div>
<!-- Destination Input -->
<div class="relative mt-stack-sm">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-energetic-orange">
<span class="material-symbols-outlined" data-icon="flag" data-weight="fill" style="font-variation-settings: 'FILL' 1;">flag</span>
</div>
<input class="w-full pl-10 pr-4 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder="To (e.g. Salou)" type="text"/>
</div>
<!-- Date & Passenger Row -->
<div class="flex gap-stack-sm mt-stack-sm">
<div class="relative flex-1">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-outline">
<span class="material-symbols-outlined" data-icon="calendar_today">calendar_today</span>
</div>
<input class="w-full pl-10 pr-2 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder="Today" type="text"/>
</div>
<div class="relative flex-1">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-outline">
<span class="material-symbols-outlined" data-icon="person">person</span>
</div>
<input class="w-full pl-10 pr-2 py-3 bg-surface-bright border border-surface-variant rounded-lg font-body-md text-on-surface focus:outline-none focus:border-coastal-teal focus:ring-1 focus:ring-coastal-teal transition-all" placeholder="1 Passenger" type="text"/>
</div>
</div>
</div>
<!-- Primary Action -->
<button class="w-full mt-stack-md bg-energetic-orange text-white font-button text-button py-4 rounded-lg flex justify-center items-center gap-2 hover:bg-opacity-90 transition-opacity shadow-md">
<span class="material-symbols-outlined" data-icon="search">search</span>
                    SEARCH BUSES
                </button>
</div>
</section>
<!-- Quick Access Services (Bento Grid Style) -->
<section class="px-margin-mobile py-stack-md">
<h2 class="font-headline-md text-headline-md text-deep-navy mb-stack-md px-2">Popular Services</h2>
<div class="grid grid-cols-2 gap-stack-md">
<!-- Airport Transfers Card -->
<div class="col-span-2 relative bg-surface-container-lowest rounded-xl overflow-hidden shadow-[0px_4px_20px_rgba(1,57,144,0.06)] border border-surface-variant group">
<div class="bg-cover bg-center w-full h-32 relative" data-alt="A bright, sunlit Mediterranean coastal highway viewed from inside a modern, comfortable bus. The bright blue sea is visible in the background. The mood is relaxed, safe, and vacation-ready. The overall color palette is warm with bright blues and subtle orange highlights." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDhPy7mprqFfw1F2synvePredTy7sScMXIgwyM6NGsIoRdWij-RbKFrrqFlSn3wSPjbWd7mc8SrjYYr8_aTfUrTLLlFSFFrBg9-XUS0-cLSKxlItrWvTQo2VlNrp_LnTqd1L8cpdIGlGi_IuzaNj46QyOY4MC1BHRKkT4Y_fNV0vMR0_AoNMVU4wJeXkW31MRFzIdLYZJWqTpWRle-yUO6iVUIQ5aZwtgxquUYZrXMmjWDvoFYgy8wz')">
<div class="absolute inset-0 bg-gradient-to-t from-deep-navy/80 to-transparent"></div>
</div>
<div class="absolute bottom-0 left-0 p-stack-md text-white">
<div class="font-label-md text-label-md uppercase tracking-wider mb-1 text-secondary-fixed">Express Route</div>
<h3 class="font-headline-md text-[20px] leading-tight font-bold">Airport Transfers</h3>
</div>
<button class="absolute bottom-4 right-4 bg-white/20 backdrop-blur-sm rounded-full p-2 text-white group-hover:bg-white group-hover:text-deep-navy transition-colors">
<span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
</button>
</div>
<!-- Excursions Card -->
<div class="col-span-1 bg-surface-container-lowest rounded-xl p-stack-md shadow-[0px_4px_20px_rgba(1,57,144,0.06)] border border-surface-variant flex flex-col items-start gap-stack-sm hover:border-coastal-teal transition-colors">
<div class="bg-surface-container-low p-3 rounded-lg text-coastal-teal">
<span class="material-symbols-outlined" data-icon="tour">tour</span>
</div>
<div>
<h3 class="font-label-md text-label-md text-deep-navy font-bold">Excursions</h3>
<p class="font-body-md text-[13px] text-on-surface-variant mt-1 leading-snug">Day trips &amp; tours</p>
</div>
</div>
<!-- Timetables Card -->
<div class="col-span-1 bg-surface-container-lowest rounded-xl p-stack-md shadow-[0px_4px_20px_rgba(1,57,144,0.06)] border border-surface-variant flex flex-col items-start gap-stack-sm hover:border-coastal-teal transition-colors">
<div class="bg-surface-container-low p-3 rounded-lg text-primary-container">
<span class="material-symbols-outlined" data-icon="schedule">schedule</span>
</div>
<div>
<h3 class="font-label-md text-label-md text-deep-navy font-bold">Timetables</h3>
<p class="font-body-md text-[13px] text-on-surface-variant mt-1 leading-snug">Local bus schedules</p>
</div>
</div>
</div>
</section>
</main>
</BaseLayout>
