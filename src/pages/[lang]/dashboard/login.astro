---
import { localizedPath } from "@/config/i18n/routing";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { getLocale, getDictionary } from "@/config/i18n";
import { dashboardHomeForRole } from "@/lib/acl";
import { getSession } from "@/lib/auth";
import { oauthProviders } from "@/config/config.env";
import SocialAuthButtons from "@/components/auth/SocialAuthButtons.astro";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (session) return Astro.redirect(localizedPath(dashboardHomeForRole(session.role), getLocale(Astro.params.lang)));

const locale = getLocale(Astro.params.lang);
const dict = getDictionary(locale);
const redirect = Astro.url.searchParams.get("redirect") ?? "";
---

<AuthLayout title={dict.app.auth.loginTitle} locale={locale}>
	<h1 class="text-3xl font-bold tracking-tight text-deep-navy">
		{dict.app.auth.loginTitle}
	</h1>
	<p class="mt-3 text-sm leading-6 text-on-surface-variant">
		{dict.app.auth.subtitle}
	</p>

	<form id="login-form" class="mt-8 flex flex-col gap-5">
		<input type="hidden" name="redirect" value={redirect} />
		<div>
			<label for="username" class="mb-2 block text-sm font-semibold text-on-surface">
				{dict.app.auth.username}
			</label>
			<input
				id="username"
				name="username"
				type="text"
				autocomplete="username"
				autocapitalize="none"
				required
				class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
			/>
		</div>
		<div>
			<label for="passkey" class="mb-2 block text-sm font-semibold text-on-surface">
				{dict.app.auth.passkey}
			</label>
			<input
				id="passkey"
				name="passkey"
				type="password"
				autocomplete="current-password"
				required
				class="min-h-12 w-full rounded-lg border border-outline-variant bg-surface px-4 text-base text-on-surface transition focus:border-coastal-teal focus:outline-none focus:ring-2 focus:ring-coastal-teal/20"
			/>
		</div>
		<p
			id="login-error"
			class="hidden rounded-lg bg-error-container px-4 py-3 text-sm text-on-error-container"
			role="alert"
			aria-live="polite"
		></p>
		<button
			type="submit"
			class="inline-flex min-h-12 items-center justify-center rounded-lg bg-energetic-orange px-6 font-semibold text-on-background transition-colors hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy disabled:cursor-wait disabled:opacity-60"
		>
			{dict.app.auth.login}
		</button>
	</form>

	<SocialAuthButtons
		providers={oauthProviders}
		callbackURL={`/api/auth/exchange?locale=${locale}${redirect ? `&redirect=${encodeURIComponent(redirect)}` : ""}`}
		googleLabel={dict.app.auth.google}
		githubLabel={dict.app.auth.github}
		dividerLabel={dict.app.auth.orContinueWith}
		errorMessage={dict.app.auth.oauthError}
	/>

	<p class="mt-6 text-center text-sm text-on-surface-variant">
		{dict.app.register.haveAccount}
		<a
			class="font-semibold text-deep-navy underline decoration-coastal-teal underline-offset-4 hover:text-secondary"
			href={localizedPath("/dashboard/register", locale)}
		>
			{dict.common.nav.register}
		</a>
	</p>

	<script define:vars={{ locale, profilePath: localizedPath("/perfil", locale), invalidMessage: dict.app.auth.invalid, connectionMessage: dict.app.auth.connectionError, oauthErrorMessage: dict.app.auth.oauthError }}>
		const form = document.getElementById("login-form");
		const error = document.getElementById("login-error");
		const submit = form?.querySelector('button[type="submit"]');

		if (new URLSearchParams(window.location.search).get("oauth") === "failed" && error) {
			error.textContent = oauthErrorMessage;
			error.classList.remove("hidden");
		}

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!(form instanceof HTMLFormElement) || !(submit instanceof HTMLButtonElement)) return;
			error?.classList.add("hidden");
			submit.disabled = true;
			submit.setAttribute("aria-busy", "true");

			try {
				const fields = new FormData(form);
				const response = await fetch("/api/auth/login", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						username: fields.get("username"),
						passkey: fields.get("passkey"),
						redirect: fields.get("redirect"),
						locale,
					}),
				});
				if (!response.ok) {
					if (error) {
						error.textContent = invalidMessage;
						error.classList.remove("hidden");
					}
					return;
				}
				const result = await response.json();
				window.location.assign(result.next ?? profilePath);
			} catch {
				if (error) {
					error.textContent = connectionMessage;
					error.classList.remove("hidden");
				}
			} finally {
				submit.disabled = false;
				submit.removeAttribute("aria-busy");
			}
		});
	</script>
</AuthLayout>
