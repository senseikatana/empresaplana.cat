---
import { localizedPath } from "@/config/i18n/routing";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getSession } from "@/lib/auth";
import { getPublicUser } from "@/lib/get-public-user";
import { getLocale, getDictionary } from "@/config/i18n";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
	return Astro.redirect(localizedPath("/dashboard/login", getLocale(Astro.params.lang)));
}

const locale = getLocale(Astro.params.lang);
const dict = getDictionary(locale);

const user = await getPublicUser(session.id);

const shortcuts = [
	{ href: "/dashboard/cliente/cuenta", icon: "person", label: dict.app.panel.account },
	{ href: "/dashboard/cliente/favoritas", icon: "star", label: dict.app.panel.favorites },
	{ href: "/dashboard/cliente/cotizaciones", icon: "request_quote", label: dict.app.panel.quotes },
	{ href: "/dashboard/mensajes", icon: "forum", label: dict.app.panel.messages },
];
---

<DashboardLayout title={dict.app.panel.home} locale={locale} user={user}>
	<div class="space-y-6">
		<!-- Header -->
		<div>
			<h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-deep-navy">
				{dict.app.auth.welcome}, {user?.name ?? session.username}
			</h1>
			<p class="font-body-md text-body-md text-on-surface-variant mt-1">
				{dict.app.role[session.role]}
			</p>
		</div>

		<!-- Quick Access Cards (HyperUI style) -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{shortcuts.map((s) => (
				<a
					href={localizedPath(s.href, locale)}
					class="flex flex-col gap-4 rounded-xl border border-surface-variant bg-surface-container-lowest p-6 shadow-ambient hover:border-coastal-teal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coastal-teal transition-colors"
				>
					<div class="w-12 h-12 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center">
						<span class="material-symbols-outlined icon-filled text-[24px]">{s.icon}</span>
					</div>
					<span class="font-label-md text-label-md text-deep-navy text-center">{s.label}</span>
				</a>
			))}
		</div>
	</div>
</DashboardLayout>