---
import { localizedPath } from "@/config/i18n/routing";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getSession } from "@/lib/auth";
import { getPublicUser } from "@/lib/get-public-user";
import { prisma } from "@/lib/db";
import { EXPIRY_WARNING_DAYS } from "@/lib/management";
import { getLocale, getDictionary } from "@/config/i18n";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
	return Astro.redirect(localizedPath("/dashboard/login", getLocale(Astro.params.lang)));
}

const locale = getLocale(Astro.params.lang);
const dict = getDictionary(locale);

const user = await getPublicUser(session.id);

// Fetch fleet summary
const today = new Date(`${new Date().toISOString().slice(0, 10)}T00:00:00.000Z`);
const warningLimit = new Date(today.getTime() + EXPIRY_WARNING_DAYS * 86_400_000);
const [
	routesCount,
	busesCount,
	stopsCount,
	driversCount,
	expiredDocs,
	expiringDocs,
	openIncidents,
	pendingMaintenance,
	alerts,
] = await Promise.all([
	prisma().route.count(),
	prisma().bus.count(),
	prisma().stop.count(),
	prisma().driver.count(),
	prisma().vehicleDocument.count({ where: { expiresOn: { lt: today } } }),
	prisma().vehicleDocument.count({ where: { expiresOn: { gte: today, lte: warningLimit } } }),
	prisma().incident.count({ where: { status: { not: "resolved" } } }),
	prisma().maintenance.count({ where: { status: { not: "completed" } } }),
	prisma().vehicleDocument.findMany({
		where: { expiresOn: { lte: warningLimit } },
		orderBy: { expiresOn: "asc" },
		take: 8,
		include: { bus: { select: { number: true, plate: true } } },
	}),
]);
const fields = dict.management.fields;
const docsHref = localizedPath("/dashboard/gestion/documentos", locale);
const daysLeft = (day: Date) => Math.round((day.getTime() - today.getTime()) / 86_400_000);

const kpis = [
	{ label: dict.app.gestion.nav.routes, value: routesCount, icon: "route", color: "text-coastal-teal" },
	{ label: dict.app.gestion.nav.buses, value: busesCount, icon: "directions_bus", color: "text-coastal-teal" },
	{ label: dict.app.gestion.nav.stops, value: stopsCount, icon: "location_on", color: "text-coastal-teal" },
	{ label: dict.app.gestion.nav.drivers, value: driversCount, icon: "badge", color: "text-coastal-teal" },
];
const fleetKpis = [
	{ label: fields.expiredDocuments, value: expiredDocs, icon: "gpp_bad", href: docsHref, color: expiredDocs > 0 ? "text-error" : "text-coastal-teal" },
	{ label: fields.expiringDocuments, value: expiringDocs, icon: "event_upcoming", href: docsHref, color: expiringDocs > 0 ? "text-error" : "text-coastal-teal" },
	{ label: fields.openIncidents, value: openIncidents, icon: "report_problem", href: localizedPath("/dashboard/gestion/incidencias", locale), color: openIncidents > 0 ? "text-error" : "text-coastal-teal" },
	{ label: fields.pendingMaintenance, value: pendingMaintenance, icon: "build", href: localizedPath("/dashboard/gestion/mantenimiento", locale), color: "text-coastal-teal" },
];
---

<DashboardLayout title={dict.app.gestion.nav.panel} locale={locale} user={user}>
	<div class="space-y-6">
		<!-- Header -->
		<div>
			<h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-deep-navy">
				{dict.app.gestion.nav.panel}
			</h1>
			<p class="font-body-md text-body-md text-on-surface-variant mt-1">
				{dict.app.title}
			</p>
		</div>

		<!-- KPI Stats Grid (HyperUI style) -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{kpis.map((k) => (
				<article class="flex flex-col gap-4 rounded-xl border border-surface-variant bg-surface-container-lowest p-6 shadow-ambient">
					<div class="flex items-center justify-between">
						<div>
							<p class="font-label-md text-label-md text-on-surface-variant">{k.label}</p>
							<p class="font-headline-lg font-bold text-deep-navy mt-1 tabular-nums">{k.value}</p>
						</div>
						<span class={`material-symbols-outlined ${k.color} text-[32px] shrink-0`} aria-hidden="true">{k.icon}</span>
					</div>
				</article>
			))}
		</div>

		<!-- Fleet KPIs with links -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{fleetKpis.map((k) => (
				<a
					href={k.href}
					class="flex flex-col gap-4 rounded-xl border border-surface-variant bg-surface-container-lowest p-6 shadow-ambient hover:border-coastal-teal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-surface transition-colors"
				>
					<div class="flex items-center justify-between">
						<div>
							<p class="font-label-md text-label-md text-on-surface-variant">{k.label}</p>
							<p class="font-headline-lg font-bold text-deep-navy mt-1 tabular-nums">{k.value}</p>
						</div>
						<span class={`material-symbols-outlined ${k.color} text-[32px] shrink-0`} aria-hidden="true">{k.icon}</span>
					</div>
				</a>
			))}
		</div>

		<!-- Expiry Alerts Section -->
		<section class="rounded-xl border border-surface-variant bg-surface-container-lowest p-6 shadow-ambient" aria-labelledby="expiry-alerts">
			<div class="flex items-center justify-between">
				<h2 id="expiry-alerts" class="font-headline-md text-headline-md font-bold text-deep-navy">
					{fields.expiryAlerts}
				</h2>
				<a
					href={docsHref}
					class="text-sm font-semibold text-coastal-teal hover:underline"
				>
					{dict.management.common.viewAll}
				</a>
			</div>
			{alerts.length === 0
				? <p class="mt-4 text-on-surface-variant">{fields.noExpiryAlerts}</p>
				: <ul class="mt-4 divide-y divide-outline-variant">
					{alerts.map((doc) => {
						const days = daysLeft(doc.expiresOn);
						return (
							<li class="flex flex-wrap items-center justify-between gap-2 py-3">
								<a class="font-semibold text-deep-navy hover:underline" href={`${docsHref}?view=${doc.id}`}>
									{doc.bus.number} · {fields[doc.docType] ?? doc.docType}
								</a>
								<span class={`rounded-full px-3 py-1 text-xs font-semibold ${days < 0 ? "bg-error-container text-on-error-container" : "bg-surface-container-high text-on-surface"}`}>
									{doc.expiresOn.toISOString().slice(0, 10)} · {(days < 0 ? fields.expiredDaysAgo : fields.expiresInDays).replace("{days}", String(Math.abs(days)))}
								</span>
							</li>
						);
					})}
				</ul>}
		</section>
	</div>
</DashboardLayout>