---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getSession } from "@/lib/auth";
import { getPublicUser } from "@/lib/get-public-user";
import { prisma } from "@/lib/db";
import { getLocale, getDictionary } from "@/config/i18n";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
	return Astro.redirect("/dashboard/login");
}

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);

const user = await getPublicUser(session.id);

const budgets = await prisma().budget.findMany({
	where: { userId: session.id },
	orderBy: { createdAt: "desc" },
});

function statusLabel(status: string): string {
	return dict.app.status[status as keyof typeof dict.app.status] ?? status;
}

function statusColor(status: string): string {
	if (status === "contracted") return "bg-secondary-fixed/30 text-on-surface";
	return "bg-surface-container text-on-surface";
}
---

<DashboardLayout title={dict.app.panel.quotes} locale={locale} user={user}>
	<div>
		<h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-deep-navy">
			{dict.app.panel.quotes}
		</h1>

		{budgets.length === 0 && (
			<div class="mt-6 rounded-lg bg-surface-container-low border border-surface-variant px-4 py-3 text-on-surface-variant text-sm">
				{dict.app.panel.quotesEmpty}
			</div>
		)}

		{budgets.length > 0 && (
			<div class="flex flex-col gap-4 mt-6">
				{budgets.map((b) => (
					<div class="bg-surface-container-lowest rounded-xl shadow-ambient border border-surface-variant p-6">
						<div class="flex items-start justify-between gap-4">
							<div>
								<h3 class="font-headline-md text-headline-md font-bold text-deep-navy">
									{b.departureCity} → {b.arrivalCity}
								</h3>
								<p class="font-body-md text-body-md text-on-surface-variant mt-1">
									{b.departureDay} {b.departureTime}{b.people ? ` · ${b.people}` : ""}
								</p>
							</div>
							<span class={`inline-flex items-center rounded-full px-3 py-1 font-label-md text-label-md ${statusColor(b.status)}`}>
								{statusLabel(b.status)}
							</span>
						</div>
					</div>
				))}
			</div>
		)}
	</div>
</DashboardLayout>
