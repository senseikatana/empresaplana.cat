---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getSession } from "@/lib/auth";
import { getPublicUser } from "@/lib/get-public-user";
import { prisma } from "@/lib/db";
import { getLocale, getDictionary } from "@/config/i18n";

export const prerender = false;

const session = await getSession(Astro.cookies);
if (!session) {
	return Astro.redirect("/dashboard/login");
}

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);

const user = await getPublicUser(session.id);

const routes = await prisma().route.findMany({
	orderBy: { code: "asc" },
});
---

<DashboardLayout title={dict.app.panel.lines} locale={locale} user={user}>
	<div>
		<h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-deep-navy">
			{dict.app.panel.lines}
		</h1>

		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
			{routes.map((r) => (
				<div class="bg-surface-container-lowest rounded-xl shadow-ambient border border-surface-variant p-6">
					<div class="flex items-center gap-2">
						<span class="h-3 w-3 rounded-full inline-block" style={`background-color: ${r.color}`} />
						<span class="font-label-md text-label-md font-bold text-on-surface">{r.code}</span>
						<span class={`ml-auto inline-flex items-center rounded-full px-3 py-1 font-label-md text-label-md ${r.status === "active" ? "bg-secondary-fixed/30 text-on-surface" : "bg-surface-container text-on-surface"}`}>
							{r.status}
						</span>
					</div>
					<p class="font-headline-md text-headline-md font-bold text-deep-navy mt-2">{r.name}</p>
					<p class="font-body-md text-body-md text-on-surface-variant">{r.origin} → {r.destination}</p>
				</div>
			))}

			{routes.length === 0 && (
				<div class="col-span-full rounded-lg bg-surface-container-low border border-surface-variant px-4 py-3 text-on-surface-variant text-sm">
					{dict.app.worker.noLineData}
				</div>
			)}
		</div>
	</div>
</DashboardLayout>
