---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Rutas y Horarios - Sin resultados">
	<main class="mx-auto flex min-h-[70vh] w-full max-w-container items-center justify-center px-margin-mobile py-stack-lg md:px-margin-desktop">
		<section class="max-w-xl text-center">
			<div class="mx-auto mb-stack-md grid size-20 place-items-center rounded-full bg-surface-container-low text-4xl text-deep-navy">⌕</div>
			<h1 class="mb-stack-sm text-display-lg font-bold text-deep-navy">No se han encontrado líneas</h1>
			<p class="mb-stack-lg text-body-lg text-on-surface-variant">No encontramos rutas que coincidan con tu búsqueda. Prueba con otras localidades o activa los transbordos.</p>
			<a class="inline-flex rounded bg-energetic-orange px-stack-md py-stack-sm font-semibold text-white" href="/rutas-horarios">Restablecer búsqueda</a>
		</section>
	</main>
</BaseLayout>
