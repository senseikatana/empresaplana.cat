---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TownSelect from "@/components/TownSelect.astro";
import { getSiteInfo, getCanonicalUrl } from "@/config/site-info";
import { getLocale, getDictionary, LOCALES } from "@/config/i18n";
import { CONTACT, POPULAR_LINES } from "@/data";

export const prerender = false;

const locale = getLocale(Astro.url.searchParams.get("lang"));
const dict = getDictionary(locale);
const common = dict.common;
const home = dict.homeContent;
const routeSearch = dict.routes.search;
const siteInfo = getSiteInfo({
	title: dict.meta.title,
	description: dict.meta.description,
	lang: locale,
	canonicalUrl: getCanonicalUrl(Astro.url.pathname),
	ogTitle: dict.meta.title,
	ogDescription: dict.meta.description,
});
const localePath = (path: string) => `${path}?lang=${locale}`;
const pdfLocale = locale === "fr" ? "es" : locale;
const routeSearchAction = `${localePath("/rutas-horarios")}#results`;
const heroImage = "/images/empresa-plana-fleet.jpg";
---

<BaseLayout
	{...siteInfo}
	bodyClass="bg-background text-on-background font-body-md antialiased min-h-screen flex flex-col"
>
	<header class="relative z-20 bg-surface-container-lowest">
		<div class="hidden border-b border-outline-variant/40 bg-deep-navy text-on-primary md:block">
			<div class="mx-auto flex max-w-container-max items-center justify-end gap-6 px-margin-desktop py-2 text-sm">
				<a
					class="inline-flex items-center gap-2 transition-colors hover:text-secondary-fixed"
					href={`tel:${CONTACT.generalPhone.replace(/\s+/g, "")}`}
				>
					<span aria-hidden="true" class="material-symbols-outlined text-lg">call</span>
					{CONTACT.generalPhone}
				</a>
				<span aria-hidden="true" class="h-4 w-px bg-on-primary/30"></span>
				<div class="flex items-center gap-3" aria-label={common.brand}>
					{LOCALES.map((language) => (
						<a
							class={`transition-colors hover:text-secondary-fixed ${language === locale ? "font-bold text-white" : "text-on-primary/75"}`}
							href={`/?lang=${language}`}
							aria-current={language === locale ? "page" : undefined}
						>
							{common.lang[language]}
						</a>
					))}
				</div>
			</div>
		</div>
		<div class="mx-auto flex max-w-container-max items-center justify-between gap-4 px-margin-mobile py-4 md:px-margin-desktop">
			<a
				class="shrink-0 text-xl font-bold tracking-tight text-deep-navy md:text-2xl"
				href={localePath("/")}
				aria-label={common.brand}
			>
				{common.brand}
			</a>
			<nav class="hidden items-center gap-7 text-sm font-semibold text-on-surface-variant lg:flex" aria-label={common.brand}>
				<a class="transition-colors hover:text-deep-navy" href={localePath("/servicios-discrecionales")}>
					{common.nav.services}
				</a>
				<a class="transition-colors hover:text-deep-navy" href={localePath("/donde-estamos")}>
					{common.nav.locations}
				</a>
				<a class="transition-colors hover:text-deep-navy" href={localePath("/rutas-horarios")}>
					{common.nav.downloads}
				</a>
				<a class="transition-colors hover:text-deep-navy" href="#contacto">
					{common.nav.contact}
				</a>
			</nav>
			<div class="flex items-center gap-3">
				<div class="flex items-center gap-2 text-xs font-semibold text-on-surface-variant md:hidden" aria-label={common.brand}>
					{LOCALES.map((language) => (
						<a
							class={`transition-colors hover:text-deep-navy ${language === locale ? "font-bold text-deep-navy" : ""}`}
							href={`/?lang=${language}`}
							aria-current={language === locale ? "page" : undefined}
						>
							{common.lang[language]}
						</a>
					))}
				</div>
				<a
					class="inline-flex min-h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-energetic-orange px-5 text-sm font-bold text-on-background shadow-[0_4px_12px_rgba(1,57,144,0.16)] transition-colors hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy"
					href={localePath("/rutas-horarios")}
				>
					{common.nav.bookNow}
				</a>
			</div>
		</div>
		<nav
			class="overflow-x-auto border-t border-outline-variant/30 px-margin-mobile lg:hidden"
			aria-label={common.brand}
		>
			<div class="mx-auto flex max-w-container-max items-center gap-6 py-3 text-sm font-semibold text-on-surface-variant">
				<a class="shrink-0 hover:text-deep-navy" href={localePath("/servicios-discrecionales")}>
					{common.nav.services}
				</a>
				<a class="shrink-0 hover:text-deep-navy" href={localePath("/donde-estamos")}>
					{common.nav.locations}
				</a>
				<a class="shrink-0 hover:text-deep-navy" href={localePath("/rutas-horarios")}>
					{common.nav.downloads}
				</a>
				<a class="shrink-0 hover:text-deep-navy" href="#contacto">
					{common.nav.contact}
				</a>
			</div>
		</nav>
	</header>

	<main class="flex-grow">
		<section class="relative isolate flex min-h-[470px] items-center overflow-hidden bg-deep-navy md:min-h-[560px]">
			<img
				class="absolute inset-0 h-full w-full object-cover object-center"
				src={heroImage}
				alt=""
				width="1294"
				height="1009"
				fetchpriority="high"
				decoding="async"
			/>
			<div class="absolute inset-0 bg-gradient-to-r from-deep-navy/90 via-deep-navy/65 to-deep-navy/15"></div>
			<div class="absolute inset-0 bg-gradient-to-t from-deep-navy/35 via-transparent to-transparent"></div>
			<div class="relative mx-auto w-full max-w-container-max px-margin-mobile py-20 md:px-margin-desktop md:py-28">
				<div class="max-w-3xl text-white">
					<h1 class="max-w-2xl text-4xl font-bold leading-[1.05] tracking-[-0.035em] md:text-6xl">
						{common.brand}
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-white/90 md:text-xl">
						{dict.meta.description}
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a
							class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-energetic-orange px-6 text-sm font-bold text-on-background transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
							href={localePath("/rutas-horarios")}
						>
							<span aria-hidden="true" class="material-symbols-outlined">directions_bus</span>
							{common.nav.downloads}
						</a>
						<a
							class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/70 px-6 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-deep-navy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
							href={localePath("/servicios-discrecionales")}
						>
							{common.nav.services}
						</a>
					</div>
				</div>
			</div>
			<div class="absolute bottom-0 left-0 right-0 h-1 bg-coastal-teal"></div>
		</section>

		<section class="relative z-10 mx-auto -mt-8 w-full max-w-container-max px-margin-mobile md:-mt-12 md:px-margin-desktop">
			<div class="rounded-2xl bg-surface-container-lowest p-5 shadow-[0_18px_50px_rgba(1,37,99,0.16)] md:p-8">
				<div class="mb-6 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
					<div>
						<h2 class="text-2xl font-bold tracking-tight text-deep-navy md:text-3xl">
							{routeSearch.title}
						</h2>
						<p class="mt-2 max-w-2xl text-sm leading-6 text-on-surface-variant md:text-base">
							{dict.routes.hero.subtitle}
						</p>
					</div>
					<a
						class="hidden items-center gap-1 text-sm font-semibold text-deep-navy underline decoration-coastal-teal decoration-2 underline-offset-4 hover:text-secondary md:inline-flex"
						href={localePath("/rutas-horarios")}
					>
						{dict.routes.search.direct}
						<span aria-hidden="true" class="material-symbols-outlined text-lg">arrow_forward</span>
					</a>
				</div>
				<form
					class="grid gap-4 md:grid-cols-[1fr_1fr_auto] md:items-end"
					method="post"
					action={routeSearchAction}
				>
					<div>
						<label
							class="mb-2 block text-sm font-semibold text-on-surface-variant"
							for="home-origin"
						>
							{routeSearch.originLabel}
						</label>
						<TownSelect
							id="home-origin"
							name="origin"
							placeholder={routeSearch.originPlaceholder}
							defaultValue="Tarragona"
							icon="trip_origin"
						/>
					</div>
					<div>
						<label
							class="mb-2 block text-sm font-semibold text-on-surface-variant"
							for="home-destination"
						>
							{routeSearch.destinationLabel}
						</label>
						<TownSelect
							id="home-destination"
							name="destination"
							placeholder={routeSearch.destinationPlaceholder}
							defaultValue="Salou"
							icon="location_on"
						/>
					</div>
					<button
						class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-deep-navy px-6 font-semibold text-white transition-colors hover:bg-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coastal-teal"
						type="submit"
					>
						<span aria-hidden="true" class="material-symbols-outlined">search</span>
						{routeSearch.submit}
					</button>
				</form>
				<p class="mt-4 text-xs leading-5 text-on-surface-variant">
					{routeSearch.disclaimer}
				</p>
			</div>
		</section>

		<section class="mx-auto max-w-container-max px-margin-mobile pb-20 pt-20 md:px-margin-desktop md:pb-28 md:pt-28">
			<div class="flex flex-col gap-5 border-b border-outline-variant/50 pb-7 md:flex-row md:items-end md:justify-between">
				<div>
					<h2 class="max-w-2xl text-3xl font-bold tracking-tight text-deep-navy md:text-4xl">
						{dict.homeVariant1.routes.title}
					</h2>
					<p class="mt-3 max-w-2xl leading-7 text-on-surface-variant">
						{dict.routes.results.directTitle}
					</p>
				</div>
				<a
					class="inline-flex w-fit items-center gap-2 font-semibold text-deep-navy hover:text-secondary"
					href={localePath("/rutas-horarios")}
				>
					{common.nav.downloads}
					<span aria-hidden="true" class="material-symbols-outlined">arrow_forward</span>
				</a>
			</div>
			<ul class="divide-y divide-outline-variant/40">
				{POPULAR_LINES.map((line) => (
					<li class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between">
						<div class="min-w-0">
							<h3 class="text-lg font-semibold leading-6 text-on-surface">
								{line.name}
							</h3>
							<p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-on-surface-variant">
								<span>{line.origin}</span>
								<span aria-hidden="true" class="material-symbols-outlined text-base text-coastal-teal">arrow_forward</span>
								<span>{line.destination}</span>
							</p>
						</div>
						<a
							class="inline-flex min-h-11 shrink-0 items-center gap-2 self-start rounded-lg border border-outline-variant/70 px-4 text-sm font-semibold text-deep-navy transition-colors hover:border-deep-navy hover:bg-surface-container-low focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coastal-teal sm:self-auto"
							href={line.pdfUrls[pdfLocale]}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span aria-hidden="true" class="material-symbols-outlined text-lg">picture_as_pdf</span>
							{dict.routes.results.downloadPdf}
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="bg-surface-container-low">
			<div class="mx-auto grid max-w-container-max gap-8 px-margin-mobile py-16 md:grid-cols-[1.1fr_0.9fr] md:items-center md:px-margin-desktop md:py-20">
				<div>
					<h2 class="max-w-xl text-3xl font-bold leading-tight tracking-tight text-deep-navy md:text-4xl">
						{home.airportPromo.title}
					</h2>
					<p class="mt-5 max-w-xl text-base leading-7 text-on-surface-variant">
						{home.airportPromo.subtitle}
					</p>
					<a
						class="mt-7 inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-energetic-orange px-6 font-semibold text-on-background transition-colors hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-deep-navy"
						href="https://www.busplana.com/"
						target="_blank"
						rel="noopener noreferrer"
					>
						{home.airportPromo.cta}
						<span aria-hidden="true" class="material-symbols-outlined">north_east</span>
					</a>
				</div>
				<div class="relative min-h-64 overflow-hidden rounded-2xl bg-deep-navy p-8 text-white md:min-h-80 md:p-10">
					<div class="absolute -right-14 -top-20 h-64 w-64 rounded-full border border-white/20"></div>
					<div class="absolute -right-4 -top-10 h-44 w-44 rounded-full border border-coastal-teal/70"></div>
					<div class="relative flex h-full min-h-48 flex-col justify-between">
						<span aria-hidden="true" class="material-symbols-outlined text-5xl text-coastal-teal">flight_takeoff</span>
						<div class="mt-12">
							<p class="text-sm font-semibold uppercase tracking-[0.12em] text-white/75">
								{home.airportPromo.tag}
							</p>
							<div class="mt-4 h-px w-20 bg-coastal-teal"></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-container-max px-margin-mobile py-20 md:px-margin-desktop md:py-28">
			<div class="grid gap-8 border-b border-outline-variant/50 pb-10 md:grid-cols-[0.8fr_1.2fr] md:items-end">
				<h2 class="max-w-lg text-3xl font-bold tracking-tight text-deep-navy md:text-4xl">
					{home.valueProps.title}
				</h2>
				<p class="max-w-2xl text-base leading-7 text-on-surface-variant">
					{dict.meta.description}
				</p>
			</div>
			<div class="grid gap-x-8 gap-y-10 pt-9 sm:grid-cols-2 lg:grid-cols-4">
				{Object.values(home.valueProps.items).map((item) => (
					<article class="border-t-2 border-coastal-teal pt-4">
						<h3 class="text-lg font-semibold leading-6 text-deep-navy">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-on-surface-variant">{item.desc}</p>
					</article>
				))}
			</div>
		</section>

		<section class="bg-deep-navy text-white">
			<div class="mx-auto flex max-w-container-max flex-col gap-8 px-margin-mobile py-14 md:flex-row md:items-center md:justify-between md:px-margin-desktop md:py-16">
				<div class="max-w-3xl">
					<h2 class="text-3xl font-bold tracking-tight md:text-4xl">{home.coachRental.title}</h2>
					<p class="mt-4 text-base leading-7 text-white/85">{home.coachRental.subtitle}</p>
				</div>
				<a
					class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-lg bg-energetic-orange px-6 font-semibold text-on-background transition-colors hover:bg-tertiary-fixed-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
					href={localePath("/solicitar-presupuesto")}
				>
					{home.coachRental.quoteCta}
					<span aria-hidden="true" class="material-symbols-outlined">arrow_forward</span>
				</a>
			</div>
		</section>
	</main>

	<footer id="contacto" class="bg-surface-container-lowest">
		<div class="mx-auto max-w-container-max px-margin-mobile py-12 md:px-margin-desktop md:py-16">
			<div class="grid gap-10 border-b border-outline-variant/50 pb-10 sm:grid-cols-2 lg:grid-cols-4">
				<div>
					<a class="text-xl font-bold tracking-tight text-deep-navy" href={localePath("/")}>
						{common.brand}
					</a>
					<p class="mt-4 max-w-xs text-sm leading-6 text-on-surface-variant">
						{dict.meta.description}
					</p>
				</div>
				<div>
					<h2 class="text-sm font-bold text-deep-navy">{dict.homeVariant1.footer.services}</h2>
					<ul class="mt-4 space-y-3 text-sm text-on-surface-variant">
						<li><a class="hover:text-deep-navy" href={localePath("/rutas-horarios")}>{dict.homeVariant1.footer.routesSchedules}</a></li>
						<li><a class="hover:text-deep-navy" href={localePath("/servicios-discrecionales")}>{dict.homeVariant1.footer.privateServices}</a></li>
						<li><a class="hover:text-deep-navy" href={localePath("/donde-estamos")}>{common.nav.locations}</a></li>
					</ul>
				</div>
				<div>
					<h2 class="text-sm font-bold text-deep-navy">{dict.homeVariant1.footer.contact}</h2>
					<ul class="mt-4 space-y-3 text-sm text-on-surface-variant">
						<li><a class="hover:text-deep-navy" href={`tel:${CONTACT.generalPhone.replace(/\s+/g, "")}`}>{CONTACT.generalPhone}</a></li>
						<li><a class="hover:text-deep-navy" href="mailto:info@empresaplana.cat">info@empresaplana.cat</a></li>
						<li><a class="hover:text-deep-navy" href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
					</ul>
				</div>
				<div>
					<h2 class="text-sm font-bold text-deep-navy">{dict.homeVariant1.footer.social}</h2>
					<div class="mt-4 flex gap-4 text-sm text-on-surface-variant">
						<a class="hover:text-deep-navy" href={CONTACT.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
						<a class="hover:text-deep-navy" href={CONTACT.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
					</div>
					<ul class="mt-7 space-y-3 text-sm text-on-surface-variant">
						<li><a class="hover:text-deep-navy" href={localePath("/aviso-legal")}>{common.footer.terms}</a></li>
						<li><a class="hover:text-deep-navy" href={localePath("/politica-privacidad")}>{common.footer.privacy}</a></li>
						<li><a class="hover:text-deep-navy" href={localePath("/politica-cookies")}>{common.footer.cookies}</a></li>
					</ul>
				</div>
			</div>
			<div class="flex flex-col gap-3 pt-6 text-xs text-on-surface-variant sm:flex-row sm:items-center sm:justify-between">
				<p>{common.footer.copyright}</p>
				<a class="w-fit font-semibold text-deep-navy hover:text-secondary" href={localePath("/screens")}>
					{dict.home.title}
				</a>
			</div>
		</div>
	</footer>
</BaseLayout>
