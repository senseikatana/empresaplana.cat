{
	"name": "empresaplana-astro",
	"type": "module",
	"version": "0.7.2",
	"engines": {
		"node": ">=22.12.0 <25"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "bun run verify && astro build",
		"preview": "astro preview",
		"start": "node dist/server/entry.mjs",
		"deploy:insforge": "bun run verify && node src/scripts/deploy-insforge.mjs",
		"email:test": "bun src/scripts/test-email.ts",
		"email:manage": "bun src/scripts/manage-emails.ts",
		"tunnel": "cloudflared tunnel --url http://localhost:4321",
		"astro": "astro",
		"typecheck": "astro check",
		"test": "bun run check && bun run typecheck && bun run test:unit && bun run test:e2e",
		"test:unit": "bun test tests --path-ignore-patterns '**/*.integration.test.ts'",
		"verify": "bun run test && bun run release:check",
		"commit:check": "node src/scripts/commit-guard.mjs validate",
		"test:e2e": "playwright test --config test/playwright.config.ts",
		"test:e2e:ui": "bun run test:e2e --ui",
		"test:integration": "bun test tests/management.integration.test.ts",
		"format": "biome check --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:drift": "node src/scripts/verify-migrations.mjs",
		"db:migrate": "prisma migrate dev",
		"db:seed": "bunx tsx prisma/seed.ts",
		"db:setup": "prisma db push && prisma generate",
		"release:check": "node src/scripts/release-versions.mjs",
		"release:check:strict": "node src/scripts/release-versions.mjs --strict",
		"release:version": "node src/scripts/release-versions.mjs",
		"prepare": "husky || true",
		"build:vercel": "bun run db:generate && astro build"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.11",
		"@astrojs/vercel": "^11.0.20",
		"@astrojs/vue": "^7.1.2",
		"@insforge/sdk": "^1.5.2",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tailwindcss/vite": "^4.3.5",
		"astro": "^7.4.8",
		"dotenv": "^18.0.10",
		"eslint": "^10.14.0",
		"jose": "^6.2.17",
		"katanakit-js": "^6.8.4",
		"openai": "^7.54.0",
		"pg": "^8.23.1",
		"prettier": "^3.9.10",
		"resend": "^6.37.0",
		"tailwindcss": "^4.3.5",
		"vue": "^3.5.45",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prisma": "^7.10.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"author": "Sergio Jurado",
	"description": "Empresa Plana website, powered by Astro",
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"packageManager": "bun@1.4.3"
}
