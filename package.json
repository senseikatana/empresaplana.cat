{
	"name": "empresaplana-astro",
	"type": "module",
	"version": "0.3.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "bun run test && astro build",
		"preview": "astro preview",
		"start": "node dist/server/entry.mjs",
		"deploy:insforge": "node src/scripts/deploy-insforge.mjs",
		"email:test": "bun src/scripts/test-email.ts",
		"email:manage": "bun src/scripts/manage-emails.ts",
		"tunnel": "cloudflared tunnel --url http://localhost:4321",
		"astro": "astro",
		"typecheck": "astro check",
		"test": "bun run check && bun run typecheck && bun run test:unit && bun run test:e2e",
		"test:unit": "bun test tests --path-ignore-patterns '**/*.integration.test.ts'",
		"test:e2e": "playwright test --config test/playwright.config.ts",
		"test:e2e:ui": "bun run test:e2e --ui",
		"test:integration": "bun test tests/management.integration.test.ts",
		"format": "biome check --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate dev",
		"db:seed": "bunx tsx prisma/seed.ts",
		"db:setup": "prisma db push && prisma generate",
		"release:check": "node src/scripts/release-versions.mjs",
		"release:version": "node src/scripts/release-versions.mjs",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/node": "^11.1.7",
		"@astrojs/vue": "^7.0.3",
		"@insforge/sdk": "^1.5.2",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.8",
		"dotenv": "^18.0.7",
		"eslint": "^10.12.0",
		"jose": "^6.2.12",
		"katanakit-js": "^6.8.4",
		"openai": "^7.32.0",
		"pg": "^8.23.1",
		"prettier": "^3.9.9",
		"resend": "^6.32.1",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.43",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prisma": "^7.10.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"author": "Sergio Jurado",
	"description": "Empresa Plana website, powered by Astro",
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
