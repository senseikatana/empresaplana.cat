{
  "name": "empresaplana-astro",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run dev",
    "build": "bun run build",
    "preview": "astro preview",
    "tunnel": "cloudflared tunnel --url http://localhost:4321",
    "astro": "astro",
    "sync:sheets": "bun src/scripts/sync-sheets.mjs",
    "export:sheets": "bun src/scripts/export-sheets.mjs",
    "bootstrap:sheets": "bun src/scripts/bootstrap-sheets.mjs",
    "test": "bun run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "bunx tsx prisma/seed.ts",
    "db:setup": "prisma db push && prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "katanakit-js": "^6.8.4",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "author": "senseikatana - Sergio Jurado",
  "description": "Proyecto empresaplana-astro",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
